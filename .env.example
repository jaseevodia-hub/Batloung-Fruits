DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=batloung_fruits
PORT=5001
# Secret used to sign login tokens. Use a long random value and keep it private.
JWT_SECRET=change_this_to_a_long_random_secret

# Production (Railway MySQL sets these automatically when the database is linked):
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

# Frontend (Netlify). Set this to the Railway API URL, for example:
# VITE_API_URL=https://your-service.up.railway.app/api
